FROM python:3.10-alpine

# Set working directory
WORKDIR /app

# Install system dependencies needed to compile package extensions (like matplotlib)
RUN apk add --no-cache gcc musl-dev g++ freetype-dev libpng-dev

# Copy requirements
COPY requirements-gui.txt .

# Upgrade pip and install dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements-gui.txt

# Copy GUI code directory
COPY gui/ ./gui/

# Expose Streamlit port
EXPOSE 8501

# Run Streamlit targeting 0.0.0.0 and port 8501
CMD ["streamlit", "run", "gui/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501"]
